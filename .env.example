# Copy these settings into the ignored .env file and fill them in locally.
# Optional: absolute path to a downloaded Neo4j environment-format credentials file.
NEO4J_CREDENTIALS_FILE=
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
# Optional; leave blank to use the user's default database.
NEO4J_DATABASE=
PORT=3000
# Local deployment only. Never uploaded into the app sandbox.
DAYTONA_API_KEY=
DAYTONA_SANDBOX_NAME=invoice-nudge
